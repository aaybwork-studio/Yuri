<div class="introduction w-full h-[100vh] h-[100dvh] relative overflow-hidden" data-mods="introduction" id="IntroHero-{{ section.id }}" data-scroll-height="{{ section.settings.scroll_duration }}">
  <div class="introduction-wrapper w-full h-full relative z-10">
    
    <!-- Sound toggle button centered at the top of the frame below header -->
    <div class="absolute top-24 left-1/2 transform -translate-x-1/2 z-30 pointer-events-auto">
      <button type="button" class="text-[11px] sm:text-[12px] tracking-[0.2em] font-sans font-light uppercase text-black hover:opacity-60 transition-opacity bg-transparent border-0 cursor-pointer p-0" data-sound-toggle>
        Play Sound
      </button>
    </div>

    <div class="introduction-container w-full h-full relative" data-introduction-wrapper>
      
      <!-- Centered Loader -->
      <div class="introduction-loader absolute inset-0 z-40 flex flex-col items-center justify-center bg-[#faf8f1] transition-opacity duration-500 ease-out" data-intro-loader>
        <div class="flex flex-col items-center space-y-4">
          <div class="w-8 h-8 border-[1.5px] border-black/10 border-t-[#ff6f00] rounded-full animate-spin"></div>
          <span class="text-[9px] tracking-[0.35em] font-sans font-light uppercase text-black/40">LOADING</span>
        </div>
      </div>

      <div class="introduction-media w-full h-full relative">
        
          {%- if section.settings.image_desktop != blank or section.settings.image_mobile != blank -%}
            {%- if section.settings.image_mobile != blank -%}
              {{ section.settings.image_mobile | image_url: width: 1000 | image_tag: 
                class: 'introduction-media-mobile w-full h-full object-cover opacity-0 transition-opacity duration-300',
                loading: 'eager',
                fetchpriority: 'high'
              }}
            {%- else -%}
              {{ section.settings.image_desktop | image_url: width: 2000 | image_tag: 
                class: 'introduction-media-mobile w-full h-full object-cover opacity-0 transition-opacity duration-300',
                loading: 'eager',
                fetchpriority: 'high'
              }}
            {%- endif -%}

            {%- if section.settings.image_desktop != blank -%}
              {{ section.settings.image_desktop | image_url: width: 2000 | image_tag: 
                class: 'introduction-media-desktop w-full h-full object-cover opacity-0 transition-opacity duration-300',
                loading: 'eager',
                fetchpriority: 'high'
              }}
            {%- else -%}
              {{ section.settings.image_mobile | image_url: width: 1000 | image_tag: 
                class: 'introduction-media-desktop w-full h-full object-cover opacity-0 transition-opacity duration-300',
                loading: 'eager',
                fetchpriority: 'high'
              }}
            {%- endif -%}
          {%- else -%}
            <video autoplay loop muted playsinline class="introduction-media-video w-full h-full object-cover opacity-0 transition-opacity duration-300 absolute inset-0">
              <source src="{{ 'hero-bg-video.mp4' | asset_url }}" type="video/mp4">
            </video>
          {%- endif -%}
        </div>

        <div class="introduction-logo absolute inset-0 z-30 flex flex-col items-center justify-center pointer-events-none px-4" data-introduction-logo>
          <!-- Japanese Vertical Display (Dia font, 2 characters vertically stacked) -->
          <div class="haiku-hero-container flex flex-col items-center justify-center text-center space-y-6">
            <div class="japanese-display h-48 flex items-center justify-center select-none">
              <span class="japanese-pair text-[64px] sm:text-[80px] font-sans font-light tracking-[0.2em] leading-tight flex flex-col items-center justify-center text-black dark:text-white" data-haiku-ja-hero style="writing-mode: vertical-rl; text-orientation: upright;">
                かり
              </span>
            </div>
            <!-- English Subtitle in Warm Yellow/Ochre -->
            <div class="english-display h-8 flex items-center justify-center select-none">
              <p class="english-sub text-[10px] sm:text-[11px] tracking-[0.35em] font-sans uppercase text-[#d9a752] font-light transition-all duration-300" data-haiku-en-hero>
                for a brief moment
              </p>
            </div>
          </div>
        </div>

        <audio id="BgAudioWaves" loop preload="auto" class="hidden">
          <source src="{{ 'Sea Waves - Sound Effect.mp3' | asset_url }}" type="audio/mpeg">
        </audio>
        <audio id="BgAudioBowl" loop preload="auto" class="hidden">
          <source src="{{ 'Singing bowl.mp3' | asset_url }}" type="audio/mpeg">
        </audio>
      </div>

      <!-- Animated downward pointed arrow at the bottom of the screen -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-30 pointer-events-none flex justify-center items-center select-none" data-scroll-arrow>
        <svg class="w-6 h-6 text-black animate-bounce" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
        </svg>
      </div>
    </div>
  </div>
  <div class="introduction-background absolute inset-0 bg-[#faf8f1] z-20 pointer-events-none" data-introduction-background></div>
</div>

{% schema %}
{
  "name": "Yuri Intro Scroll Hero",
  "tag": "section",
  "class": "section-intro",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop Hero Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Hero Image (Vertical Aspect)"
    },
    {
      "type": "textarea",
      "id": "logo_svg",
      "label": "SVG Logo Markup",
      "info": "Paste raw SVG markup here. Fill will be overridden to white."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image Fallback"
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "min": 200,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Scroll Pinning Distance",
      "default": 600
    }
  ],
  "presets": [
    {
      "name": "Yuri Intro Scroll Hero"
    }
  ]
}
{% endschema %}
{% comment %} Force sync update {% endcomment %}
