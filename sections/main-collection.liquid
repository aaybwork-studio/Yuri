{%- liquid
  assign products_per_page = section.settings.products_per_page
-%}

{% paginate collection.products by products_per_page %}
<div class="collection-page w-full bg-cream pt-12 pb-24 font-sans text-xs tracking-widest uppercase text-black transition-colors duration-300">
  
  <!-- Collection Header (Below Hero Section) -->
  <div class="text-center mb-16 px-6">
    <h1 class="text-lg font-normal tracking-[0.2em] uppercase m-0 text-black">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="description text-neutral-500 max-w-xl mx-auto mt-4 normal-case text-[11px] font-light tracking-wide leading-relaxed">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  <!-- Interlocking Product Grid (5 Columns for 35% bigger tiles) -->
  <div class="max-w-[1400px] mx-auto px-4 md:px-8">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-y-8 md:gap-y-12 border-t border-b border-black/10 py-12">
      {% for product in collection.products %}
        {% assign mod = forloop.index0 | modulo: 4 %}
        
        {% comment %} Row 1 End Spacer: After 2nd product in group of 4 (which are index 0, 1) {% endcomment %}
        {% if mod == 2 %}
          <div class="hidden md:block md:col-span-1 bg-transparent"></div>
        {% endif %}

        {% comment %} Row 2 Start Spacer: Before 3rd product in group of 4 (which is index 2) {% endcomment %}
        {% if mod == 2 %}
          <div class="hidden md:block md:col-span-1 bg-transparent"></div>
        {% endif %}

        <a href="{{ product.url }}" class="col-span-2 md:col-span-2 grid grid-cols-2 group border border-black/10 bg-cream hover:bg-neutral-50 transition-colors duration-300">
          <!-- Image tile -->
          <div class="aspect-square bg-neutral-100 overflow-hidden relative border-r border-black/10">
            {% if product.featured_image != blank %}
              <img src="{{ product.featured_image | image_url: width: 800 }}" 
                   alt="{{ product.title | escape }}" 
                   class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" 
                   loading="lazy" 
                   width="{{ product.featured_image.width }}" 
                   height="{{ product.featured_image.height }}">
            {% else %}
              <div class="w-full h-full flex items-center justify-center bg-neutral-150">
                <span class="text-neutral-400 text-[10px]">NO IMAGE</span>
              </div>
            {% endif %}
          </div>
          <!-- Details tile -->
          <div class="aspect-square flex flex-col justify-between p-4 md:p-6 bg-transparent">
            <div class="text-[9px] tracking-[0.2em] font-normal text-neutral-400 uppercase">
              {%- if product.vendor -%}{{ product.vendor }}{%- else -%}YURI{%- endif -%}
            </div>
            <div class="space-y-2">
              <h3 class="text-[11px] font-normal tracking-widest leading-snug text-black group-hover:underline">
                {{ product.title }}
              </h3>
              <p class="text-[10px] text-neutral-500 font-sans tracking-wide">
                {{ product.price | money }}
              </p>
            </div>
          </div>
        </a>
      {% else %}
        <div class="col-span-full text-center py-24 text-neutral-400">
          NO PRODUCTS FOUND IN THIS COLLECTION
        </div>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <div class="mt-16 flex justify-center text-[10px] tracking-[0.2em] uppercase text-black">
        {{ paginate | default_pagination }}
      </div>
    {% endif %}
  </div>
</div>
{% endpaginate %}

{% schema %}
{
  "name": "Main Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 36,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
