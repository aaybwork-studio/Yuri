{%- liquid
  assign combustion = product.metafields.custom.combustion
  assign poids = product.metafields.custom.poids
  assign dimensions = product.metafields.custom.dimensions
  assign delivery = product.metafields.custom.delivery_info

  # Parse tags as fallbacks
  for tag in product.tags
    if tag contains 'Combustion:' or tag contains 'combustion:'
      assign combustion = tag | split: ':' | last | strip
    elsif tag contains 'Poids:' or tag contains 'poids:'
      assign poids = tag | split: ':' | last | strip
    elsif tag contains 'Dimensions:' or tag contains 'dimensions:'
      assign dimensions = tag | split: ':' | last | strip
    elsif tag contains 'Delivery:' or tag contains 'delivery:'
      assign delivery = tag | split: ':' | last | strip
    endif
  endfor
-%}

<div class="product-page bg-[#faf8f1] h-[calc(100vh-80px)] overflow-hidden text-black mt-20">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-0 items-stretch h-full">
    
    <!-- Left: Fixed Image Box with Light Grey Background and Slider Controls -->
    <div class="relative bg-[#e8e6df] h-[40vh] md:h-full flex items-center justify-center border-b md:border-b-0 md:border-r border-black/10 select-none group">
      {% if product.images.size > 0 %}
        <div class="relative w-full h-full flex items-center justify-center overflow-hidden">
          {% for image in product.images %}
            <img 
              src="{{ image.src | image_url: width: 1200 }}" 
              alt="{{ product.title | escape }}" 
              class="product-slider-img absolute w-full h-full object-cover transition-opacity duration-500 ease-in-out {% if forloop.first %}opacity-100 z-10{% else %}opacity-0 z-0{% endif %}" 
              data-index="{{ forloop.index0 }}"
              loading="eager"
              width="{{ image.width }}" 
              height="{{ image.height }}"
            >
          {% endfor %}
        </div>

        {% if product.images.size > 1 %}
          <!-- Left Arrow -->
          <button 
            type="button" 
            class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 bg-transparent text-black/40 hover:text-black p-2 transition-colors duration-200 focus:outline-none"
            onclick="rotateSlider(-1)"
            aria-label="Previous Image"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
          
          <!-- Right Arrow -->
          <button 
            type="button" 
            class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 bg-transparent text-black/40 hover:text-black p-2 transition-colors duration-200 focus:outline-none"
            onclick="rotateSlider(1)"
            aria-label="Next Image"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        {% endif %}
      {% else %}
        <div class="w-full aspect-[3/4] bg-neutral-200 flex items-center justify-center">
          <span class="text-neutral-400 text-[10px] tracking-widest uppercase">NO IMAGE AVAILABLE</span>
        </div>
      {% endif %}
    </div>

    <!-- Right: Independently Scrollable Details -->
    <div class="flex flex-col justify-between bg-[#faf8f1] p-8 md:p-16 lg:p-24 h-[60vh] md:h-full overflow-y-auto no-scrollbar space-y-12">
      
      <!-- Top / Info Section -->
      <div class="space-y-10">
        <!-- Combustion / Poids / Dimensions Metadata -->
        <div class="grid grid-cols-3 gap-4 border-b border-black/[0.05] pb-8">
          <div>
            <span class="text-[9px] tracking-[0.25em] font-bold text-black/40 block uppercase mb-1">COMBUSTION</span>
            <span class="text-[11px] font-bold tracking-wide text-black block">
              {%- if combustion != blank -%}{{ combustion }}{%- else -%}65h{%- endif -%}
            </span>
          </div>
          <div>
            <span class="text-[9px] tracking-[0.25em] font-bold text-black/40 block uppercase mb-1">POIDS</span>
            <span class="text-[11px] font-bold tracking-wide text-black block">
              {%- if poids != blank -%}{{ poids }}{%- else -%}500g{%- endif -%}
            </span>
          </div>
          <div>
            <span class="text-[9px] tracking-[0.25em] font-bold text-black/40 block uppercase mb-1">DIMENSIONS</span>
            <span class="text-[11px] font-bold tracking-wide text-black block normal-case font-sans">
              {%- if dimensions != blank -%}{{ dimensions }}{%- else -%}Height 11cm, diameter 10,5cm{%- endif -%}
            </span>
          </div>
        </div>

        <!-- Title & Description -->
        <div class="space-y-6">
          <h1 class="text-sm font-bold tracking-[0.2em] uppercase m-0 leading-tight">
            {{ product.title }}
          </h1>

          {% if product.description != blank %}
            <div class="product-description text-[11px] text-neutral-500 font-sans tracking-wide leading-relaxed normal-case">
              {{ product.description }}
            </div>
          {% endif %}
        </div>

        <!-- Delivery & Services -->
        <div class="space-y-3 pt-6 border-t border-black/[0.05]">
          <span class="text-[9px] tracking-[0.25em] font-bold text-black/40 block uppercase">LIVRAISON & SERVICES</span>
          <div class="text-[11px] text-neutral-500 font-sans tracking-wide leading-relaxed normal-case space-y-1">
            {%- if delivery != blank -%}
              {{ delivery }}
            {%- else -%}
              <p>Paiement sécurisé par Mastercard-Visa-PayPal</p>
              <p>Délai d'expédition: sous 3 jours ouvrés</p>
              <p>Livraison: 2 à 5 jours pour la France, 7 à 14 jours à l'international</p>
              <p>Retour gratuit sous condition: contacter le service client</p>
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- Bottom / CTA Section -->
      <div class="space-y-8 pt-8">
        
        <!-- Form and Select options -->
        <form method="post" action="{{ routes.cart_add_url }}" class="space-y-6">
          {% if product.variants.size > 1 %}
            <div class="space-y-2">
              <label class="block text-[9px] tracking-[0.25em] font-bold text-black/40 uppercase">SELECT YOUR OPTION +</label>
              <select name="id" class="w-full border-b border-black/10 focus:border-black bg-transparent py-2 outline-none font-sans text-xs tracking-widest text-black rounded-none transition-colors">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="flex flex-col space-y-4">
            <!-- Price Block -->
            <div>
              <span class="text-[13px] font-bold tracking-widest text-black block">
                {{ product.price | money }}
              </span>
              <span class="text-[9px] tracking-[0.2em] text-neutral-400 block uppercase mt-0.5">Taxes included</span>
            </div>

            <!-- Add to Bag -->
            <button 
              type="submit" 
              class="w-full bg-transparent border border-black/20 hover:border-black text-black/80 hover:text-black py-3.5 text-center text-[10px] tracking-[0.25em] uppercase font-sans font-bold rounded-none transition-colors duration-300"
            >
              ADD TO BAG
            </button>
          </div>
        </form>

        <!-- Wishlist -->
        <div class="border-t border-black/[0.05] pt-4">
          <button type="button" class="text-[10px] tracking-[0.25em] font-bold text-black/60 hover:text-black bg-transparent border-0 cursor-pointer p-0 uppercase">
            WISHLIST +
          </button>
        </div>
      </div>

    </div>

  </div>
</div>

<script>
  let currentSliderIndex = 0;
  const sliderImages = document.querySelectorAll('.product-slider-img');
  const totalSliderImages = sliderImages.length;

  function rotateSlider(direction) {
    if (totalSliderImages <= 1) return;
    
    // Hide current image
    sliderImages[currentSliderIndex].classList.remove('opacity-100', 'z-10');
    sliderImages[currentSliderIndex].classList.add('opacity-0', 'z-0');
    
    // Calculate new index
    currentSliderIndex = (currentSliderIndex + direction + totalSliderImages) % totalSliderImages;
    
    // Show new image
    sliderImages[currentSliderIndex].classList.remove('opacity-0', 'z-0');
    sliderImages[currentSliderIndex].classList.add('opacity-100', 'z-10');
  }
</script>
